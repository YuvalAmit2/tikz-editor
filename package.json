{
  "name": "tikz-editor",
  "version": "0.1.0",
  "description": "A fast TikZ figure editor for live-TeXing",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && npm run build:electron",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "install-sty": "scripts/install-sty.sh",
    "test:app": "npm run build && playwright test -c playwright.electron.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuvalAmit2/tikz-editor.git"
  },
  "author": "Yuval Amit",
  "license": "MIT",
  "dependencies": {
    "monaco-editor": "^0.57.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
